# Copy to .env for local development. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://estate:estate@localhost:5432/estate_access
REDIS_URL=redis://localhost:6379/0
# Set to true in production behind a TLS-terminating proxy
DJANGO_BEHIND_PROXY=false
DJANGO_SECURE_SSL_REDIRECT=false
API_DOCS_ENABLED=true
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
# Optional separate key for HMAC of stored codes (defaults to DJANGO_SECRET_KEY)
CREDENTIAL_PEPPER=
\n# Optional FCM delivery. Keep service-account JSON in a secret manager, not source control.\nFCM_ENABLED=false\nFCM_SERVICE_ACCOUNT_JSON=\n